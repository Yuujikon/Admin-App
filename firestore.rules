rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ─────────────────────────────────────────────────────────────────────────
    // HELPER FUNCTIONS
    // ─────────────────────────────────────────────────────────────────────────

    function isSignedIn() {
      return request.auth != null;
    }

    function hasTokenRole(role) {
      return isSignedIn() &&
        ('role' in request.auth.token && request.auth.token.role == role);
    }

    function isSuperAdmin() {
      return isSignedIn() && (
        request.auth.token.get('admin', false) == true ||
        request.auth.token.get('email', '') == 'markjeo.hinampas@gmail.com'
      );
    }

    function getStaffRole() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', 'customer')
        : 'customer';
    }

    function isAdmin() {
      return isSuperAdmin() || hasTokenRole('admin') || (isSignedIn() && getStaffRole() == 'admin');
    }

    function isStaff() {
      return isAdmin() ||
        hasTokenRole('cashier') ||
        hasTokenRole('inventoryManager') ||
        (isSignedIn() && getStaffRole() in ['cashier', 'inventoryManager']);
    }

    function isCustomerReservationUpdate() {
      let affected = request.resource.data.diff(resource.data).affectedKeys();
      return isSignedIn() &&
        affected.hasOnly(['stock', 'reservedStock', 'variants', 'notifyUserIds', 'updatedAt']) &&
        request.resource.data.get('stock', 0) >= 0 &&
        request.resource.data.price == resource.data.price &&
        request.resource.data.name == resource.data.name &&
        request.resource.data.get('costPrice', 0) == resource.data.get('costPrice', 0);
    }

    // ─────────────────────────────────────────────────────────────────────────
    // 1. PRODUCTS & BUNDLES
    // ─────────────────────────────────────────────────────────────────────────
    match /products/{productId} {
      allow read: if true;
      allow create, delete: if isAdmin() || isStaff();
      allow update: if isAdmin() || isStaff() || isCustomerReservationUpdate();
    }

    match /bundles/{bundleId} {
      allow read: if true;
      allow write: if isAdmin() || isStaff();
    }

    // ─────────────────────────────────────────────────────────────────────────
    // 2. RESTOCK INQUIRIES & MANAGEMENT
    // ─────────────────────────────────────────────────────────────────────────
    match /restock_inquiries/{inquiryId} {
      allow read, write: if isSignedIn() || isStaff();
    }

    match /suppliers/{supplierId} {
      allow read: if true;
      allow write: if isSignedIn() || isStaff() || isAdmin();
    }

    match /delivery_logs/{logId} {
      allow read, write: if isSignedIn() || isStaff();
    }

    match /loss_records/{lossId} {
      allow read, write: if isSignedIn() || isStaff();
    }

    match /expenses/{expenseId} {
      allow read, write: if isSignedIn() || isStaff();
    }

    match /customers/{customerId} {
      allow read, write: if isSignedIn() || isStaff();
    }

    match /stock_audits/{auditId} {
      allow create, read, update, delete: if isSignedIn() || isStaff();
    }

    match /catalog/{catalogId} {
      allow read: if true;
      allow write: if isSignedIn() || isStaff();
    }

    // ─────────────────────────────────────────────────────────────────────────
    // 3. TRANSACTIONS & SHIFTS
    // ─────────────────────────────────────────────────────────────────────────
    match /transactions/{txId} {
      allow read: if isAdmin() || isStaff() || (isSignedIn() && resource.data.get('cashierId', '') == request.auth.uid);
      allow create: if (isStaff() || isSignedIn()) && request.resource.data.get('total', 0) >= 0;
      allow update, delete: if isAdmin();
    }

    match /shifts/{shiftId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.get('cashierId', '') == request.auth.uid);
      allow create: if (isStaff() || isSignedIn()) && request.resource.data.cashierId == request.auth.uid;
      allow update: if isAdmin() || (isSignedIn() && resource.data.cashierId == request.auth.uid);
      allow delete: if isAdmin();
    }

    // ─────────────────────────────────────────────────────────────────────────
    // 4. STORE SETTINGS
    // ─────────────────────────────────────────────────────────────────────────
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isSignedIn() || isStaff() || isAdmin();
    }

    match /store_settings/{settingId} {
      allow read: if true;
      allow write: if isSignedIn() || isStaff() || isAdmin();
    }

    // ─────────────────────────────────────────────────────────────────────────
    // 5. USERS & NOTIFICATIONS
    // ─────────────────────────────────────────────────────────────────────────
    match /users/{userId} {
      allow read: if isSignedIn();
      allow write: if isAdmin() || (isSignedIn() && request.auth.uid == userId);

      match /notifications/{notificationId} {
        allow read, write: if isSignedIn() && (request.auth.uid == userId || isStaff());
      }
    }

    // ─────────────────────────────────────────────────────────────────────────
    // 6. ONLINE PRE-ORDERS & REFUNDS
    // ─────────────────────────────────────────────────────────────────────────
    match /orders/{orderId} {
      allow read: if isStaff() || (
        isSignedIn() && (
          resource.data.customerId == request.auth.uid ||
          (
            'email' in request.auth.token &&
            'customerEmail' in resource.data &&
            resource.data.customerEmail == request.auth.token.email
          )
        )
      );

      allow create: if isSignedIn() && (request.resource.data.get('customerId', '') == request.auth.uid || isStaff());
      allow update: if isStaff() || (
        isSignedIn() && resource.data.get('customerId', '') == request.auth.uid &&
        request.resource.data.status in ['cancelled', 'refund_requested']
      );
      allow delete: if isAdmin();
    }

    match /refund_requests/{requestId} {
      allow read: if isStaff() || (isSignedIn() && resource.data.get('customerId', '') == request.auth.uid);
      allow create: if isSignedIn();
      allow update: if isStaff();
      allow delete: if isAdmin();
    }
  }
}
