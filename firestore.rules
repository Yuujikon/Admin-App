rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ─────────────────────────────────────────────────────────────────────────
    // HELPER FUNCTIONS
    // ─────────────────────────────────────────────────────────────────────────

    function isSignedIn() {
      return request.auth != null;
    }

    function hasTokenRole(role) {
      return isSignedIn() &&
        ('role' in request.auth.token && request.auth.token.role == role);
    }

    function isSuperAdmin() {
      return isSignedIn() && (
        request.auth.token.get('admin', false) == true ||
        request.auth.token.get('email', '') == 'markjeo.hinampas@gmail.com'
      );
    }

    function getStaffRole() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', 'customer')
        : 'customer';
    }

    function isAdmin() {
      return isSuperAdmin() || hasTokenRole('admin') || (isSignedIn() && getStaffRole() == 'admin');
    }

    function isStaff() {
      return isAdmin() ||
        hasTokenRole('trustedPartner') ||
        hasTokenRole('cashier') ||
        hasTokenRole('inventoryManager') ||
        (isSignedIn() && getStaffRole() in ['trustedPartner', 'cashier', 'inventoryManager']);
    }

    function isCustomerReservationUpdate() {
      let affected = request.resource.data.diff(resource.data).affectedKeys();
      let oldReserved = resource.data.get('reservedStock', 0);
      let newReserved = request.resource.data.get('reservedStock', 0);
      let currentStock = resource.data.get('stock', 0);
      return isSignedIn() &&
        affected.hasOnly(['reservedStock', 'variants', 'notifyUserIds', 'updatedAt']) &&
        newReserved is int &&
        newReserved >= 0 &&
        (newReserved <= oldReserved || newReserved <= currentStock) &&
        request.resource.data.get('stock', 0) == currentStock &&
        request.resource.data.get('price', 0) == resource.data.get('price', 0) &&
        request.resource.data.get('name', '') == resource.data.get('name', '') &&
        request.resource.data.get('costPrice', 0) == resource.data.get('costPrice', 0);
    }

    // Check if customer is currently restricted or permanently locked due to ghosting offenses
    function isCustomerRestricted() {
      let userPath = /databases/$(database)/documents/users/$(request.auth.uid);
      let userExists = exists(userPath);
      let userDoc = userExists ? get(userPath).data : {};
      let isLocked = userDoc.get('isPermanentlyLocked', false) == true;
      let restrictedUntil = userDoc.get('restrictedUntil', userDoc.get('restrictionUntil', null));
      return isLocked || (restrictedUntil != null && request.time < restrictedUntil);
    }

    // Ensure non-staff users cannot modify their own offense counts or active lock fields
    function isNotTamperingOffenses() {
      let affected = request.resource.data.diff(resource.data).affectedKeys();
      return !affected.hasAny([
        'offenseCount',
        'restrictedUntil',
        'restrictionUntil',
        'isPermanentlyLocked',
        'lastOffenseAt',
        'offenseHistory',
        'ghostedOrders'
      ]);
    }

    function isValidCustomerOrderUpdate() {
      let affected = request.resource.data.diff(resource.data).affectedKeys();
      let oldStatus = resource.data.get('status', '');
      let newStatus = request.resource.data.get('status', '');
      let isOwner = isSignedIn() && resource.data.get('customerId', '') == request.auth.uid;

      // 1. Confirm payment on awaitingPayment reservation
      let isConfirmPayment = oldStatus == 'awaitingPayment' &&
        newStatus == 'pending' &&
        affected.hasOnly(['status', 'paymentStatus', 'isPaid', 'paymentReference', 'expiresAt']) &&
        request.resource.data.get('paymentStatus', '') == 'paid' &&
        request.resource.data.get('isPaid', false) == true &&
        request.resource.data.get('paymentReference', '') is string &&
        request.resource.data.get('paymentReference', '').size() > 0;

      // 2. Cancel active order (idempotent reservationReleased false -> true)
      let isCancelActive = oldStatus in ['awaitingPayment', 'pending', 'staging', 'ready'] &&
        newStatus == 'cancelled' &&
        affected.hasOnly(['status', 'reservationReleased']) &&
        (!affected.hasAny(['reservationReleased']) || (
          resource.data.get('reservationReleased', false) == false &&
          request.resource.data.get('reservationReleased', false) == true
        ));

      // 3. Request refund on a collected order (supports standardized refundRequested + legacy refund_requested)
      let isRequestRefund = oldStatus == 'collected' &&
        newStatus in ['refundRequested', 'refund_requested'] &&
        affected.hasOnly(['status']);

      // 4. Cancel a pending refund request (reverts order back to collected)
      let isCancelRefund = oldStatus in ['refundRequested', 'refund_requested'] &&
        newStatus == 'collected' &&
        affected.hasOnly(['status']);

      // 5. One-time pickup time extension on an active order
      let isExtendPickup = oldStatus in ['pending', 'staging', 'ready'] &&
        resource.data.get('isExtended', false) == false &&
        request.resource.data.get('isExtended', false) == true &&
        affected.hasOnly(['expiresAt', 'pickupEnd', 'isExtended', 'extensionCount']) &&
        request.resource.data.expiresAt is timestamp &&
        request.resource.data.get('extensionCount', 0) <= 1;

      return isOwner && (
        isConfirmPayment ||
        isCancelActive ||
        isRequestRefund ||
        isCancelRefund ||
        isExtendPickup
      );
    }

    // ─────────────────────────────────────────────────────────────────────────
    // 1. PRODUCTS, BUNDLES & WATCHES
    // ─────────────────────────────────────────────────────────────────────────
    match /products/{productId} {
      allow read: if true;
      allow create, delete: if isAdmin() || isStaff();
      allow update: if isAdmin() || isStaff() || isCustomerReservationUpdate();
    }

    match /bundles/{bundleId} {
      allow read: if true;
      allow write: if isAdmin() || isStaff();
    }

    match /watched_products/{watchId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isSignedIn();
    }

    // ─────────────────────────────────────────────────────────────────────────
    // 2. SUPPLIER PROCUREMENT, RECEIVING & INVENTORY MANAGEMENT
    // ─────────────────────────────────────────────────────────────────────────
    match /rfqs/{rfqId} {
      allow read, write: if isStaff();
    }

    match /purchase_orders/{poId} {
      allow read, write: if isStaff();
    }

    match /receiving_records/{recordId} {
      allow read, write: if isStaff();
    }

    match /inventory_batches/{batchId} {
      allow read: if true;
      allow write: if isStaff();
    }

    match /restock_inquiries/{inquiryId} {
      allow read, write: if isSignedIn() || isStaff();
    }

    match /suppliers/{supplierId} {
      allow read: if true;
      allow write: if isStaff() || isAdmin();
    }

    match /delivery_logs/{logId} {
      allow read: if isStaff();
      allow write: if isStaff();
    }

    match /loss_records/{lossId} {
      allow read: if isStaff();
      allow write: if isStaff();
    }

    match /expenses/{expenseId} {
      allow read: if isStaff();
      allow write: if isStaff();
    }

    match /customers/{customerId} {
      allow read, write: if isSignedIn() || isStaff();
    }

    match /stock_audits/{auditId} {
      allow create, read: if isSignedIn() || isStaff();
      allow update, delete: if isStaff() || isAdmin();
    }

    match /catalog/{catalogId} {
      allow read: if true;
      allow write: if isStaff();
    }

    // ─────────────────────────────────────────────────────────────────────────
    // 3. TRANSACTIONS & SHIFTS
    // ─────────────────────────────────────────────────────────────────────────
    match /transactions/{txId} {
      allow read: if isAdmin() || isStaff() || (isSignedIn() && resource.data.get('cashierId', '') == request.auth.uid);
      allow create: if (isStaff() || isSignedIn()) && request.resource.data.get('total', 0) >= 0;
      allow update, delete: if isAdmin();
    }

    match /shifts/{shiftId} {
      allow read: if isAdmin() || isStaff() || (isSignedIn() && resource.data.get('cashierId', '') == request.auth.uid);
      allow create: if (isStaff() || isSignedIn()) && request.resource.data.get('cashierId', '') == request.auth.uid;
      allow update: if isAdmin() || isStaff() || (isSignedIn() && resource.data.get('cashierId', '') == request.auth.uid);
      allow delete: if isAdmin();
    }

    // ─────────────────────────────────────────────────────────────────────────
    // 4. STORE SETTINGS & SYSTEM CONFIG
    // ─────────────────────────────────────────────────────────────────────────
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin() || isStaff();
    }

    match /store_settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin() || isStaff();
    }

    match /system_config/time_simulation {
      allow read, write: if true;
    }

    // ─────────────────────────────────────────────────────────────────────────
    // 5. USERS & NOTIFICATIONS
    // ─────────────────────────────────────────────────────────────────────────
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && (request.auth.uid == userId || isStaff());
      allow update: if isAdmin() || isStaff() || (
        isSignedIn() && request.auth.uid == userId && isNotTamperingOffenses()
      );
      allow delete: if isAdmin();

      match /notifications/{notificationId} {
        allow read, write: if isSignedIn() && (request.auth.uid == userId || isStaff());
      }
    }

    // ─────────────────────────────────────────────────────────────────────────
    // 6. ONLINE PRE-ORDERS & REFUNDS
    // ─────────────────────────────────────────────────────────────────────────
    match /orders/{orderId} {
      allow read: if isStaff() || (
        isSignedIn() && (
          resource.data.get('customerId', '') == request.auth.uid ||
          (
            'email' in request.auth.token &&
            'customerEmail' in resource.data &&
            resource.data.customerEmail == request.auth.token.email
          )
        )
      );

      // Block order creation if the customer is currently restricted or permanently locked
      allow create: if isSignedIn() && (
        isStaff() || (
          request.resource.data.get('customerId', '') == request.auth.uid &&
          request.resource.data.get('status', '') in ['awaitingPayment', 'pending'] &&
          request.resource.data.get('reservationReleased', false) == false &&
          !isCustomerRestricted()
        )
      );

      allow update: if isStaff() || isValidCustomerOrderUpdate();
      allow delete: if isAdmin();
    }

    match /refund_requests/{requestId} {
      allow read: if isStaff() || (
        isSignedIn() && (
          resource.data.get('customerId', '') == request.auth.uid ||
          (
            'email' in request.auth.token &&
            resource.data.get('customerEmail', '') == request.auth.token.email
          )
        )
      );
      allow create: if isSignedIn() && (
        isStaff() || (
          request.resource.data.get('customerId', '') == request.auth.uid &&
          request.resource.data.get('status', '') == 'pending'
        )
      );
      allow update: if isStaff() || (
        isSignedIn() &&
        resource.data.get('customerId', '') == request.auth.uid &&
        resource.data.get('status', '') == 'pending' &&
        request.resource.data.get('status', '') == 'cancelled' &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
      );
      allow delete: if isAdmin();
    }

    match /refund_records/{recordId} {
      allow read, write: if isStaff() || isAdmin();
    }

    // ─────────────────────────────────────────────────────────────────────────
    // 7. MAIL COLLECTION (Firebase Trigger Email Extension)
    // ─────────────────────────────────────────────────────────────────────────
    match /mail/{mailId} {
      allow create: if isSignedIn();
      allow read, update, delete: if isAdmin();
    }

    // ─────────────────────────────────────────────────────────────────────────
    // 8. OTP VERIFICATION REQUESTS
    // ─────────────────────────────────────────────────────────────────────────
    match /otp_requests/{contactMethod} {
      // Allow anyone (unauthenticated users) to create an OTP request during sign-up
      allow read, create, update, delete: if true;
    }

    // ─────────────────────────────────────────────────────────────────────────
    // 9. APPEALS (Customer Ghosting Restriction Appeals)
    // ─────────────────────────────────────────────────────────────────────────
    match /appeals/{appealId} {
      allow read: if isStaff() || (
        isSignedIn() && (
          resource.data.get('userId', '') == request.auth.uid ||
          (
            'email' in request.auth.token &&
            resource.data.get('customerEmail', '') == request.auth.token.email
          )
        )
      );
      allow create: if isSignedIn() && request.resource.data.get('userId', '') == request.auth.uid;
      allow update: if isStaff();
      allow delete: if isAdmin();
    }

    // ─────────────────────────────────────────────────────────────────────────
    // 10. AUDIT LOGS
    // ─────────────────────────────────────────────────────────────────────────
    match /audit_logs/{logId} {
      allow read: if isAdmin();
      allow create: if isSignedIn();
      allow update, delete: if false; // Strict immutability, append-only
    }
  }
}
