rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Allow any authenticated user to read and write to any document.
    // This satisfies the "allow all permission" request for rapid development/fixing.
    match /{document=**} {
      allow read, write: if request.auth != null;
    }

    /*
    // PREVIOUS RULES (for reference if you want to restore security later)

    function isAdmin() {
      return request.auth != null && request.auth.token.email == "markjeo.hinampas@gmail.com";
    }

    function isCustomer(email) {
      return request.auth != null && request.auth.token.email == email;
    }

    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /settings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /orders/{orderId} {
      allow read: if isAdmin() || isCustomer(resource.data.customerEmail);
      allow create: if request.auth != null;
      allow update: if isAdmin() || (isCustomer(resource.data.customerEmail) && request.resource.data.status == 'refund_requested');
    }

    match /refund_requests/{requestId} {
      allow read: if isAdmin() || isCustomer(resource.data.customerEmail);
      allow create: if request.auth != null;
      allow update: if isAdmin();
    }

    match /transactions/{txId} {
      allow read: if isAdmin();
      allow create: if true;
    }

    match /expenses/{expId} {
      allow read, write: if isAdmin();
    }

    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    */
  }
}