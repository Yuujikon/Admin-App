rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ─────────────────────────────────────────────────────────────────────────
    // HELPER FUNCTIONS
    // ─────────────────────────────────────────────────────────────────────────

    /// Checks if the incoming request is from an authenticated user.
    function isSignedIn() {
      return request.auth != null;
    }

    /// Fetches the user metadata document from the /users collection.
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    /// Returns true if the user is an Admin (via role field, custom claims, or primary admin email).
    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.admin == true ||
        request.auth.token.email == 'markjeo.hinampas@gmail.com' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         getUserData().role == 'admin')
      );
    }

    /// Returns true if the user has the 'cashier' role.
    function isCashier() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        getUserData().role == 'cashier'
      );
    }

    /// Returns true if the user is authorized staff (Admin, Cashier, or Inventory Manager).
    function isStaff() {
      return isSignedIn() && (
        isAdmin() ||
        isCashier() ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         getUserData().role == 'inventoryManager')
      );
    }

    // ─────────────────────────────────────────────────────────────────────────
    // 1. PRODUCTS COLLECTION
    // ─────────────────────────────────────────────────────────────────────────
    match /products/{productId} {
      // Any authenticated user or customer app can read published product catalog.
      allow read: if isSignedIn();

      // Only Admins can create new product profiles or delete products.
      allow create, delete: if isAdmin();

      // Product Updates:
      // - Admins have unrestricted update permissions.
      // - Cashiers can ONLY update stock & batches during sales checkout.
      // - INVARIANT: Stock must NEVER be negative (stock >= 0).
      allow update: if isAdmin() || (
        isStaff() &&
        request.resource.data.stock >= 0 &&
        request.resource.data.name == resource.data.name &&
        request.resource.data.price == resource.data.price &&
        request.resource.data.category == resource.data.category &&
        request.resource.data.barcode == resource.data.barcode
      );
    }

    // ─────────────────────────────────────────────────────────────────────────
    // 2. TRANSACTIONS COLLECTION (Append-Only Sales Ledger)
    // ─────────────────────────────────────────────────────────────────────────
    match /transactions/{txId} {
      // Staff can read transactions.
      allow read: if isStaff() || isAdmin();

      // Create Sale Receipt: Any staff can record a completed sale.
      allow create: if isStaff() &&
        request.resource.data.total >= 0 &&
        request.resource.data.items is list &&
        request.resource.data.items.size() > 0;

      allow update, delete: if isAdmin();
    }

    // ─────────────────────────────────────────────────────────────────────────
    // 3. SHIFTS COLLECTION (Register & Cash Drawer Control)
    // ─────────────────────────────────────────────────────────────────────────
    match /shifts/{shiftId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.cashierId == request.auth.uid);

      allow create: if isStaff() &&
        request.resource.data.cashierId == request.auth.uid &&
        request.resource.data.status == 'active' &&
        request.resource.data.openingFloat >= 0;

      allow update: if (
        resource.data.status == 'active' &&
        (isAdmin() || resource.data.cashierId == request.auth.uid) &&
        (
          request.resource.data.status == 'active' ||
          (request.resource.data.status == 'closed' &&
           request.resource.data.actualCashCounted >= 0 &&
           request.resource.data.closedAt != null)
        )
      );

      allow delete: if isAdmin();
    }

    // ─────────────────────────────────────────────────────────────────────────
    // 4. DELIVERY LOGS & LOSS RECORDS
    // ─────────────────────────────────────────────────────────────────────────
    match /delivery_logs/{logId} {
      allow read, write: if isStaff();
    }

    match /loss_records/{lossId} {
      allow read, write: if isStaff();
    }

    match /suppliers/{supplierId} {
      allow read: if isStaff();
      allow write: if isAdmin();
    }

    match /settings/{settingId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /store_settings/{settingId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /expenses/{expenseId} {
      allow read, write: if isStaff();
    }

    match /restock_inquiries/{inquiryId} {
      allow read, write: if isStaff();
    }

    match /bundles/{bundleId} {
      allow read: if isSignedIn();
      allow write: if isStaff();
    }

    match /customers/{customerId} {
      allow read, write: if isStaff();
    }

    // ─────────────────────────────────────────────────────────────────────────
    // 5. USERS & ROLES COLLECTION
    // ─────────────────────────────────────────────────────────────────────────
    match /users/{userId} {
      allow read: if isSignedIn();
      allow write: if isAdmin() || (
        isSignedIn() && request.auth.uid == userId
      );
    }

    // ─────────────────────────────────────────────────────────────────────────
    // 6. ONLINE PRE-ORDERS & REFUND REQUESTS
    // ─────────────────────────────────────────────────────────────────────────
    match /orders/{orderId} {
      allow read: if isStaff() || (isSignedIn() && resource.data.customerEmail == request.auth.token.email);
      allow create: if isSignedIn();
      allow update: if isStaff() || (
        isSignedIn() &&
        resource.data.customerEmail == request.auth.token.email &&
        request.resource.data.status == 'refund_requested'
      );
      allow delete: if isAdmin();
    }

    match /refund_requests/{requestId} {
      allow read: if isStaff() || (isSignedIn() && resource.data.customerEmail == request.auth.token.email);
      allow create: if isSignedIn();
      allow update: if isStaff();
      allow delete: if isAdmin();
    }

    match /catalog/{catalogId} {
      allow read: if isSignedIn();
      allow write: if isStaff();
    }
  }
}
